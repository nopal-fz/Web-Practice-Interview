# Salin file ini ke .env lalu isi nilainya.

# --- Database ---
# Lokal: file SQLite, buka langsung, tanpa signup.
DATABASE_URL="file:./dev.db"

# Production (Turso): buat DB di https://turso.tech, lalu pakai libsql:// URL.
#   npx turso db create soalml        -> dapat DATABASE_URL
#   npx turso db tokens create        -> dapat token, simpan sebagai DATABASE_AUTH_TOKEN
# Token WAJIB diisi di Vercel juga, kalau tidak setiap query production 401.
# DATABASE_URL="libsql://soalml-xxxx.turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOi..."

# --- Login admin (single user) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ubah-ini"
# String acak panjang, minimal 32 karakter. Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ubah-ini-jadi-string-acak-panjang"

# --- Opsional ---
# Absolute URL produksi, dipakai untuk metadata dan OG image.
# NEXT_PUBLIC_SITE_URL="https://soalml.vercel.app"
# Set "true" hanya kalau ada proxy tepercaya (Vercel) yang menulis x-forwarded-for.
# Tanpa ini semua visitor berbagi satu bucket rate limit, yaitu arah gagal yang aman.
# TRUST_PROXY="true"